  %14 = tuple_extract %13, 0
  %15 = tuple_extract %13, 1
  cond_fail %15, "arithmetic overflow"
  %17 = struct $Int (%14)
  %18 = function_ref @$s28closure_applied_use_analysis13forwardUnusedyS3fc_SiSftF : $@convention(thin) (@guaranteed @callee_guaranteed (Float) -> Float, Int, Float) -> Float
  %19 = apply %18(%0, %17, %2) : $@convention(thin) (@guaranteed @callee_guaranteed (Float) -> Float, Int, Float) -> Float
  br bb3(%19)

bb3(%21 : $Float):
