// RUN: %target-sil-opt -enable-sil-verify-all -closure-specialization %s -o - | %FileCheck %s
//
// Generated from validation-test/SILOptimizer/closure_applied_use_analysis.swift
// with -O -D DEFINITIONS_ONLY -emit-sil -module-name closure_applied_use_analysis,
// disabling closure-specialization, autodiff-closure-specialization and
// ownership-model-eliminator. Retain the recursive callees, their callers and
// closure bodies; remove debug instructions, effect summaries and unrelated main.
//
// A closure forwarded recursively without an invocation stays unspecialized,
// and the applied-use analysis must terminate.
// CHECK-LABEL: sil [ossa] @$s28closure_applied_use_analysis12unusedCalleryS2f_SiSftF :
// CHECK: %[[UNUSED:[0-9]+]] = partial_apply
// CHECK: %[[FORWARD:[0-9]+]] = function_ref @$s28closure_applied_use_analysis13forwardUnusedyS3fc_SiSftF
// CHECK: apply %[[FORWARD]](%[[UNUSED]],
// CHECK: return
//
// Recursive parameter rotation remains optimizable when interprocedural values
// are visited separately. This is a positive control: later specialization
// rounds also recover this case with the original distinct-function analysis.
// CHECK-LABEL: sil [ossa] @$s28closure_applied_use_analysis13rotatedCalleryS2f_SiSftF :
// CHECK: bb0(%[[X:[0-9]+]] : $Float, %[[DEPTH:[0-9]+]] : $Int, %[[SEED:[0-9]+]] : $Float):
// CHECK-NOT: partial_apply
// CHECK: %[[ROTATE:[0-9]+]] = function_ref @{{[^ ]+}} : $@convention(thin) (Int, Float, Float) -> Float
// CHECK: apply %[[ROTATE]](%[[DEPTH]], %[[SEED]], %[[X]]) : $@convention(thin) (Int, Float, Float) -> Float
// CHECK-NOT: partial_apply
// CHECK: return

// Only one known capturing closure is passed into the recursive rotation;
// the remaining callbacks are runtime parameters. Function-only visitation
// cannot reach the applied third parameter, and no other known callback can
// initiate a specialization round that recovers the first one.
// CHECK-LABEL: sil [ossa] @$s28closure_applied_use_analysis18mixedRotatedCalleryS2f_SiS3fcS2fctF :
// CHECK: bb0(%[[MIX_X:[0-9]+]] : $Float, %[[MIX_DEPTH:[0-9]+]] : $Int, %[[MIX_SEED:[0-9]+]] : $Float, %[[SECOND:[0-9]+]] : @guaranteed $@callee_guaranteed (Float) -> Float, %[[THIRD:[0-9]+]] : @guaranteed $@callee_guaranteed (Float) -> Float):
// CHECK-NOT: partial_apply
// CHECK: %[[MIX_FN:[0-9]+]] = function_ref @{{[^ ]*AfterRotation[^ ]*}} : $@convention(thin) (@guaranteed @callee_guaranteed (Float) -> Float, @guaranteed @callee_guaranteed (Float) -> Float, Int, Float, Float) -> Float
// CHECK: apply %[[MIX_FN]](%[[SECOND]], %[[THIRD]], %[[MIX_DEPTH]], %[[MIX_SEED]], %[[MIX_X]])
// CHECK-NOT: partial_apply
// CHECK: return

// Twelve distinct forwarding functions exceed the original eight-function
// applied-use budget. Main leaves this stack closure even after all rounds;
// the bounded value traversal must find the invocation and remove the closure.
// CHECK-LABEL: sil [ossa] @$s28closure_applied_use_analysis10deepCalleryS2f_SftF :
// CHECK: bb0(%[[DEEP_X:[0-9]+]] : $Float, %[[DEEP_SEED:[0-9]+]] : $Float):
// CHECK-NOT: partial_apply
// CHECK: %[[DEEP_FN:[0-9]+]] = function_ref @{{[^ ]*forward0[^ ]*}} : $@convention(thin) (Float, Float) -> Float
// CHECK: apply %[[DEEP_FN]](%[[DEEP_SEED]], %[[DEEP_X]]) : $@convention(thin) (Float, Float) -> Float
// CHECK-NOT: partial_apply
// CHECK: return

sil_stage canonical
import Builtin
import Swift
import SwiftShims

sil [noinline] [ossa] @$s28closure_applied_use_analysis13forwardUnusedyS3fc_SiSftF : $@convention(thin) (@guaranteed @callee_guaranteed (Float) -> Float, Int, Float) -> Float {
bb0(%0 : @guaranteed $@callee_guaranteed (Float) -> Float, %1 : $Int, %2 : $Float):
  %6 = integer_literal $Builtin.Int64, 0
  %7 = struct_extract %1, #Int._value
  %8 = builtin "cmp_eq_Int64"(%7, %6) : $Builtin.Int1
