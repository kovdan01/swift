sil @should_repeat : $@convention(thin) () -> Builtin.Int1

// The component copies are created before the original bundle, but the new
// consuming call is in a loop that can be bypassed. makeAvailable must supply
// a fresh owned triple per iteration and clean up the retained copies on exits.
// The verifier checks these lifetimes; require that the call was specialized so
// this cannot pass by leaving the original guaranteed bundle argument intact.
// CONTROL-FLOW-LABEL: sil [ossa] @loop_root :
// CONTROL-FLOW: cond_br
// CONTROL-FLOW: function_ref @$s8read_vjp{{[^ ]*}}Tf1
// CONTROL-FLOW: apply
// CONTROL-FLOW: cond_br
// CONTROL-FLOW: return
// CONTROL-FLOW-LABEL: } // end sil function
sil [ossa] @loop_root : $@convention(thin) (Builtin.Int1, Double) -> Double {
bb0(%enter : $Builtin.Int1, %x : $Double):
  %original_ref = function_ref @primal : $@convention(thin) (Double) -> Double
  %a_ref = function_ref @derivative_a : $@convention(thin) (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double)
  %b_ref = function_ref @derivative_b : $@convention(thin) (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double)
  %original = thin_to_thick_function %original_ref : $@convention(thin) (Double) -> Double to $@callee_guaranteed (Double) -> Double
  %a = thin_to_thick_function %a_ref : $@convention(thin) (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double) to $@callee_guaranteed (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double)
  %b = thin_to_thick_function %b_ref : $@convention(thin) (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double) to $@callee_guaranteed (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double)
  %function = differentiable_function [parameters 0] [results 0] %original : $@callee_guaranteed (Double) -> Double with_derivative {%a : $@callee_guaranteed (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double), %b : $@callee_guaranteed (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double)}
  cond_br %enter, bb1, bb2

// Split entry, bypass, backedge and loop-exit edges: OSSA forbids critical edges.
bb1:
  br bb3

bb2:
  br bb6

bb3:
  %consumer = function_ref @read_vjp : $@convention(thin) (Double, @guaranteed @differentiable(reverse) @callee_guaranteed (Double) -> Double) -> Double
  %value = apply %consumer(%x, %function) : $@convention(thin) (Double, @guaranteed @differentiable(reverse) @callee_guaranteed (Double) -> Double) -> Double
  %repeat_ref = function_ref @should_repeat : $@convention(thin) () -> Builtin.Int1
  %again = apply %repeat_ref() : $@convention(thin) () -> Builtin.Int1
  cond_br %again, bb4, bb5

bb4:
  br bb3

bb5:
  br bb6

bb6:
  return %x : $Double
}
