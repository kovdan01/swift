sil [noinline] [ossa] @apply_converted : $@convention(thin) (Double, @guaranteed @differentiable(reverse) @callee_guaranteed (Double) -> Double) -> Double {
bb0(%x : $Double, %function : @guaranteed $@differentiable(reverse) @callee_guaranteed (Double) -> Double):
  %result = apply %function(%x) : $@differentiable(reverse) @callee_guaranteed (Double) -> Double
  return %result : $Double
