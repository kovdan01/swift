// MIXED: %[[ROOT:[0-9]+]] = differentiable_function
// MIXED: %[[OWNED:[0-9]+]] = copy_value %[[ROOT]]
// MIXED: %[[GUARANTEED:[0-9]+]] = begin_borrow %[[ROOT]]
// MIXED: destroy_value %[[OWNED]]
// MIXED: apply %[[GUARANTEED]]
// MIXED: end_borrow %[[GUARANTEED]]
// MIXED: destroy_value %[[ROOT]]
