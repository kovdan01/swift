// RUN: %target-sil-opt -enable-sil-verify-all -closure-specialization %s > %t
// RUN: %FileCheck %s --check-prefix=COMPONENTS < %t
// RUN: %FileCheck %s --check-prefix=TWO-OWNED < %t
// RUN: %FileCheck %s --check-prefix=TWO-GUARANTEED < %t
// RUN: %FileCheck %s --check-prefix=MIXED < %t
// RUN: %FileCheck %s --check-prefix=RETURN-ONLY < %t
// RUN: %FileCheck %s --check-prefix=OUTER-CONVERT < %t
// RUN: %FileCheck %s --check-prefix=CONTROL-FLOW < %t
// REQUIRES: differentiable_programming

sil_stage canonical

import Builtin
import Swift
import _Differentiation

sil @primal : $@convention(thin) (Double) -> Double
sil @derivative_a : $@convention(thin) (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double)
sil @derivative_b : $@convention(thin) (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double)

// The first call creates a type-based specialization with the same SSA value
// in its JVP and VJP slots. The second call must reuse that specialization with
// distinct values in those slots. Reconstructing from a global map keyed by
// source component SSA would incorrectly use the JVP parameter for both slots.
//
// Only the original component is copied: this makes the first aggregate owned
// while keeping its repeated derivative component at ownership none. Repeating
// a consumed owned derivative operand would make the input SIL invalid.
sil [ossa] @same_and_distinct_components : $@convention(thin) (Double) -> (Double, Double) {
bb0(%x : $Double):
  %original_ref = function_ref @primal : $@convention(thin) (Double) -> Double
  %a_ref = function_ref @derivative_a : $@convention(thin) (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double)
  %b_ref = function_ref @derivative_b : $@convention(thin) (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double)
  %original = thin_to_thick_function %original_ref : $@convention(thin) (Double) -> Double to $@callee_guaranteed (Double) -> Double
  %a = thin_to_thick_function %a_ref : $@convention(thin) (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double) to $@callee_guaranteed (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double)
  %b = thin_to_thick_function %b_ref : $@convention(thin) (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double) to $@callee_guaranteed (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double)
  %consumer = function_ref @read_vjp : $@convention(thin) (Double, @guaranteed @differentiable(reverse) @callee_guaranteed (Double) -> Double) -> Double
  %original_copy1 = copy_value %original : $@callee_guaranteed (Double) -> Double
  %shared = differentiable_function [parameters 0] [results 0] %original_copy1 : $@callee_guaranteed (Double) -> Double with_derivative {%a : $@callee_guaranteed (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double), %a : $@callee_guaranteed (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double)}
  %first = apply %consumer(%x, %shared) : $@convention(thin) (Double, @guaranteed @differentiable(reverse) @callee_guaranteed (Double) -> Double) -> Double
  destroy_value %shared : $@differentiable(reverse) @callee_guaranteed (Double) -> Double
  %original_copy2 = copy_value %original : $@callee_guaranteed (Double) -> Double
  %distinct = differentiable_function [parameters 0] [results 0] %original_copy2 : $@callee_guaranteed (Double) -> Double with_derivative {%a : $@callee_guaranteed (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double), %b : $@callee_guaranteed (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double)}
  %second = apply %consumer(%x, %distinct) : $@convention(thin) (Double, @guaranteed @differentiable(reverse) @callee_guaranteed (Double) -> Double) -> Double
  destroy_value %distinct : $@differentiable(reverse) @callee_guaranteed (Double) -> Double
  %result = tuple (%first : $Double, %second : $Double)
  return %result : $(Double, Double)
}

// The name ending at Tf1na_n selects the component-exploded specialization,
// before ordinary closure propagation adds the concrete component identities.
// COMPONENTS-LABEL: sil shared [noinline] [ossa] @$s8read_vjp{{[^ ]*}}Tf1na_n :
// COMPONENTS-SAME: $@convention(thin) (Double, @owned @callee_guaranteed (Double) -> Double, @owned @callee_guaranteed (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double), @owned @callee_guaranteed (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double)) -> Double {
// COMPONENTS: bb0(%[[X:[0-9]+]] : $Double, %[[ORIGINAL:[0-9]+]] : @owned $@callee_guaranteed (Double) -> Double, %[[JVP:[0-9]+]] : @owned $@callee_guaranteed (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double), %[[VJP:[0-9]+]] : @owned $@callee_guaranteed (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double)):
// The reconstructed bundle consumes copies, not the owned parameters.
// A direct component apply exposed by simplification must be able to reuse
// the parameter independently (test2). Retaining an owned bundle also lets
// reabstraction-thunk specialization continue (test3).
// COMPONENTS: %[[C_ORIGINAL:[0-9]+]] = copy_value %[[ORIGINAL]]
// COMPONENTS: %[[C_JVP:[0-9]+]] = copy_value %[[JVP]]
// COMPONENTS: %[[C_VJP:[0-9]+]] = copy_value %[[VJP]]
// COMPONENTS: %[[DFI:[0-9]+]] = differentiable_function [parameters 0] [results 0] %[[C_ORIGINAL]] with_derivative {%[[C_JVP]], %[[C_VJP]]}
// The verifier checks that the aggregate and the three owned component
// parameters have independent, balanced lifetimes.
// COMPONENTS-DAG: destroy_value %[[ORIGINAL]]
// COMPONENTS-DAG: destroy_value %[[JVP]]
// COMPONENTS-DAG: destroy_value %[[VJP]]
// COMPONENTS-LABEL: } // end sil function
sil [noinline] [ossa] @read_vjp : $@convention(thin) (Double, @guaranteed @differentiable(reverse) @callee_guaranteed (Double) -> Double) -> Double {
bb0(%x : $Double, %function : @guaranteed $@differentiable(reverse) @callee_guaranteed (Double) -> Double):
  %vjp = differentiable_function_extract [vjp] %function : $@differentiable(reverse) @callee_guaranteed (Double) -> Double
  %pair = apply %vjp(%x) : $@callee_guaranteed (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double)
  (%value, %pullback) = destructure_tuple %pair : $(Double, @callee_guaranteed (Double) -> Double)
  destroy_value %pullback : $@callee_guaranteed (Double) -> Double
  return %value : $Double
}

// All three components below are contextless values with ownership none, so
// the aggregate also has ownership none. Such a value may be passed to two
// consuming parameters. Its rebuilt owned counterpart needs an independent
// owned value for each parameter; consuming the same rebuilt value twice is
// invalid. The verifier run checks both copies' lifetimes after specialization.
sil [ossa] @duplicate_owned_root : $@convention(thin) (Double) -> (Double, Double) {
bb0(%x : $Double):
  %original_ref = function_ref @primal : $@convention(thin) (Double) -> Double
  %a_ref = function_ref @derivative_a : $@convention(thin) (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double)
  %b_ref = function_ref @derivative_b : $@convention(thin) (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double)
  %original = thin_to_thick_function %original_ref : $@convention(thin) (Double) -> Double to $@callee_guaranteed (Double) -> Double
  %a = thin_to_thick_function %a_ref : $@convention(thin) (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double) to $@callee_guaranteed (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double)
  %b = thin_to_thick_function %b_ref : $@convention(thin) (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double) to $@callee_guaranteed (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double)
  %function = differentiable_function [parameters 0] [results 0] %original : $@callee_guaranteed (Double) -> Double with_derivative {%a : $@callee_guaranteed (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double), %b : $@callee_guaranteed (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double)}
  %consumer = function_ref @take_two_owned : $@convention(thin) (Double, @owned @differentiable(reverse) @callee_guaranteed (Double) -> Double, @owned @differentiable(reverse) @callee_guaranteed (Double) -> Double) -> (Double, Double)
  %result = apply %consumer(%x, %function, %function) : $@convention(thin) (Double, @owned @differentiable(reverse) @callee_guaranteed (Double) -> Double, @owned @differentiable(reverse) @callee_guaranteed (Double) -> Double) -> (Double, Double)
  return %result : $(Double, Double)
}

// Exactly one component triple is added for the repeated root.
// TWO-OWNED-LABEL: sil shared [noinline] [ossa] @$s14take_two_owned{{[^ ]*}}Tf1naC1_n :
// TWO-OWNED-SAME: $@convention(thin) (Double, @owned @callee_guaranteed (Double) -> Double, @owned @callee_guaranteed (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double), @owned @callee_guaranteed (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double)) -> (Double, Double) {
// TWO-OWNED: %[[ROOT:[0-9]+]] = differentiable_function
// TWO-OWNED: %[[FIRST:[0-9]+]] = copy_value %[[ROOT]]
// TWO-OWNED: %[[SECOND:[0-9]+]] = copy_value %[[ROOT]]
// TWO-OWNED: destroy_value %[[FIRST]]
// TWO-OWNED: destroy_value %[[SECOND]]
// TWO-OWNED: destroy_value %[[ROOT]]
// TWO-OWNED: return
// TWO-OWNED-LABEL: } // end sil function
sil [noinline] [ossa] @take_two_owned : $@convention(thin) (Double, @owned @differentiable(reverse) @callee_guaranteed (Double) -> Double, @owned @differentiable(reverse) @callee_guaranteed (Double) -> Double) -> (Double, Double) {
bb0(%x : $Double, %first : @owned $@differentiable(reverse) @callee_guaranteed (Double) -> Double, %second : @owned $@differentiable(reverse) @callee_guaranteed (Double) -> Double):
  %first_borrow = begin_borrow %first : $@differentiable(reverse) @callee_guaranteed (Double) -> Double
  %value1 = apply %first_borrow(%x) : $@differentiable(reverse) @callee_guaranteed (Double) -> Double
  end_borrow %first_borrow : $@differentiable(reverse) @callee_guaranteed (Double) -> Double
  destroy_value %first : $@differentiable(reverse) @callee_guaranteed (Double) -> Double
  %second_borrow = begin_borrow %second : $@differentiable(reverse) @callee_guaranteed (Double) -> Double
  %value2 = apply %second_borrow(%x) : $@differentiable(reverse) @callee_guaranteed (Double) -> Double
  end_borrow %second_borrow : $@differentiable(reverse) @callee_guaranteed (Double) -> Double
  destroy_value %second : $@differentiable(reverse) @callee_guaranteed (Double) -> Double
  %result = tuple (%value1 : $Double, %value2 : $Double)
  return %result : $(Double, Double)
}

