// RUN: %target-sil-opt -enable-sil-verify-all -closure-specialization %s > %t
// RUN: %FileCheck %s --check-prefix=COMPONENTS-A < %t
// RUN: %FileCheck %s --check-prefix=COMPONENTS-B < %t
// RUN: %FileCheck %s --check-prefix=NO-STAGE < %t
// RUN: %FileCheck %s --check-prefix=TWO-OWNED < %t
// RUN: %FileCheck %s --check-prefix=TWO-GUARANTEED < %t
// RUN: %FileCheck %s --check-prefix=MIXED < %t
// RUN: %FileCheck %s --check-prefix=RETURN-ONLY < %t
// RUN: %FileCheck %s --check-prefix=OUTER-CONVERT < %t
// RUN: %FileCheck %s --check-prefix=CONTROL-FLOW < %t
// REQUIRES: differentiable_programming

sil_stage canonical

import Builtin
import Swift
import _Differentiation

sil @primal : $@convention(thin) (Double) -> Double
sil @derivative_a : $@convention(thin) (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double)
sil @derivative_b : $@convention(thin) (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double)

// These calls have the same component types but different VJP identities.
// Direct cloning must give them different specializations, with no component
// parameters. Sharing the first construction's JVP/VJP SSA value must not make
// the second specialization use derivative_a in place of derivative_b.
//
// Only the original component is copied: this makes the first aggregate owned
// while keeping its repeated derivative component at ownership none. Repeating
// a consumed owned derivative operand would make the input SIL invalid.
// COMPONENTS-A-LABEL: sil [ossa] @same_and_distinct_components :
// COMPONENTS-A: function_ref @[[FN_A:\$s8read_vjp[^ ]+]] : $@convention(thin) (Double) -> Double
// COMPONENTS-A: } // end sil function
// COMPONENTS-A: sil shared [noinline] [ossa] @[[FN_A]] : $@convention(thin) (Double) -> Double {
// COMPONENTS-A-NOT: } // end sil function
// COMPONENTS-A-DAG: %[[A_REF:[0-9]+]] = function_ref @derivative_a :
// COMPONENTS-A-DAG: %[[A:[0-9]+]] = thin_to_thick_function %[[A_REF]]
// COMPONENTS-A-NOT: } // end sil function
// COMPONENTS-A: differentiable_function {{.*}} with_derivative {%[[A]], %[[A]]}
// COMPONENTS-A: } // end sil function
// COMPONENTS-B-LABEL: sil [ossa] @same_and_distinct_components :
// COMPONENTS-B: function_ref @{{\$s8read_vjp[^ ]+}} : $@convention(thin) (Double) -> Double
// COMPONENTS-B: function_ref @[[FN_B:\$s8read_vjp[^ ]+]] : $@convention(thin) (Double) -> Double
// COMPONENTS-B: } // end sil function
// COMPONENTS-B: sil shared [noinline] [ossa] @[[FN_B]] : $@convention(thin) (Double) -> Double {
// COMPONENTS-B-NOT: } // end sil function
// COMPONENTS-B-DAG: %[[A_REF:[0-9]+]] = function_ref @derivative_a :
// COMPONENTS-B-DAG: %[[A:[0-9]+]] = thin_to_thick_function %[[A_REF]]
// COMPONENTS-B-DAG: %[[B_REF:[0-9]+]] = function_ref @derivative_b :
// COMPONENTS-B-DAG: %[[B:[0-9]+]] = thin_to_thick_function %[[B_REF]]
// COMPONENTS-B-NOT: } // end sil function
// COMPONENTS-B: differentiable_function {{.*}} with_derivative {%[[A]], %[[B]]}
// COMPONENTS-B: } // end sil function
// No component-exploded function is emitted, even under this single-pass run.
// NO-STAGE: sil_stage canonical
// NO-STAGE-NOT: {{^sil .*Tf1[naC0-9]*a[naC0-9]*_n :}}
sil [ossa] @same_and_distinct_components : $@convention(thin) (Double) -> (Double, Double) {
bb0(%x : $Double):
  %original_ref = function_ref @primal : $@convention(thin) (Double) -> Double
  %a_ref = function_ref @derivative_a : $@convention(thin) (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double)
  %b_ref = function_ref @derivative_b : $@convention(thin) (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double)
  %original = thin_to_thick_function %original_ref : $@convention(thin) (Double) -> Double to $@callee_guaranteed (Double) -> Double
  %a = thin_to_thick_function %a_ref : $@convention(thin) (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double) to $@callee_guaranteed (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double)
  %b = thin_to_thick_function %b_ref : $@convention(thin) (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double) to $@callee_guaranteed (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double)
  %consumer = function_ref @read_vjp : $@convention(thin) (Double, @guaranteed @differentiable(reverse) @callee_guaranteed (Double) -> Double) -> Double
  %original_copy1 = copy_value %original : $@callee_guaranteed (Double) -> Double
  %shared = differentiable_function [parameters 0] [results 0] %original_copy1 : $@callee_guaranteed (Double) -> Double with_derivative {%a : $@callee_guaranteed (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double), %a : $@callee_guaranteed (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double)}
  %first = apply %consumer(%x, %shared) : $@convention(thin) (Double, @guaranteed @differentiable(reverse) @callee_guaranteed (Double) -> Double) -> Double
  destroy_value %shared : $@differentiable(reverse) @callee_guaranteed (Double) -> Double
  %original_copy2 = copy_value %original : $@callee_guaranteed (Double) -> Double
  %distinct = differentiable_function [parameters 0] [results 0] %original_copy2 : $@callee_guaranteed (Double) -> Double with_derivative {%a : $@callee_guaranteed (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double), %b : $@callee_guaranteed (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double)}
  %second = apply %consumer(%x, %distinct) : $@convention(thin) (Double, @guaranteed @differentiable(reverse) @callee_guaranteed (Double) -> Double) -> Double
  destroy_value %distinct : $@differentiable(reverse) @callee_guaranteed (Double) -> Double
  %result = tuple (%first : $Double, %second : $Double)
  return %result : $(Double, Double)
}

sil [noinline] [ossa] @read_vjp : $@convention(thin) (Double, @guaranteed @differentiable(reverse) @callee_guaranteed (Double) -> Double) -> Double {
bb0(%x : $Double, %function : @guaranteed $@differentiable(reverse) @callee_guaranteed (Double) -> Double):
  %vjp = differentiable_function_extract [vjp] %function : $@differentiable(reverse) @callee_guaranteed (Double) -> Double
  %pair = apply %vjp(%x) : $@callee_guaranteed (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double)
  (%value, %pullback) = destructure_tuple %pair : $(Double, @callee_guaranteed (Double) -> Double)
  destroy_value %pullback : $@callee_guaranteed (Double) -> Double
  return %value : $Double
}

// All three components below are contextless values with ownership none, so
// the aggregate also has ownership none. Such a value may be passed to two
// consuming parameters. Direct cloning preserves ownership none, so both
// parameters can still use that value without introducing independent owners.
// This must not be implemented by promoting the root and adding copies.
sil [ossa] @duplicate_owned_root : $@convention(thin) (Double) -> (Double, Double) {
bb0(%x : $Double):
  %original_ref = function_ref @primal : $@convention(thin) (Double) -> Double
  %a_ref = function_ref @derivative_a : $@convention(thin) (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double)
  %b_ref = function_ref @derivative_b : $@convention(thin) (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double)
  %original = thin_to_thick_function %original_ref : $@convention(thin) (Double) -> Double to $@callee_guaranteed (Double) -> Double
  %a = thin_to_thick_function %a_ref : $@convention(thin) (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double) to $@callee_guaranteed (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double)
  %b = thin_to_thick_function %b_ref : $@convention(thin) (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double) to $@callee_guaranteed (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double)
  %function = differentiable_function [parameters 0] [results 0] %original : $@callee_guaranteed (Double) -> Double with_derivative {%a : $@callee_guaranteed (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double), %b : $@callee_guaranteed (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double)}
  %consumer = function_ref @take_two_owned : $@convention(thin) (Double, @owned @differentiable(reverse) @callee_guaranteed (Double) -> Double, @owned @differentiable(reverse) @callee_guaranteed (Double) -> Double) -> (Double, Double)
  %result = apply %consumer(%x, %function, %function) : $@convention(thin) (Double, @owned @differentiable(reverse) @callee_guaranteed (Double) -> Double, @owned @differentiable(reverse) @callee_guaranteed (Double) -> Double) -> (Double, Double)
  return %result : $(Double, Double)
}

// TWO-OWNED-LABEL: sil shared [noinline] [ossa] @$s14take_two_owned{{[^ ]*}} : $@convention(thin) (Double) -> (Double, Double) {
// TWO-OWNED-NOT: copy_value
// TWO-OWNED: %[[ROOT:[0-9]+]] = differentiable_function
// TWO-OWNED-SAME: ownership: none
// TWO-OWNED-NOT: copy_value
// TWO-OWNED: return
// TWO-OWNED-NOT: copy_value
// TWO-OWNED-LABEL: } // end sil function
sil [noinline] [ossa] @take_two_owned : $@convention(thin) (Double, @owned @differentiable(reverse) @callee_guaranteed (Double) -> Double, @owned @differentiable(reverse) @callee_guaranteed (Double) -> Double) -> (Double, Double) {
bb0(%x : $Double, %first : @owned $@differentiable(reverse) @callee_guaranteed (Double) -> Double, %second : @owned $@differentiable(reverse) @callee_guaranteed (Double) -> Double):
  %first_borrow = begin_borrow %first : $@differentiable(reverse) @callee_guaranteed (Double) -> Double
  %value1 = apply %first_borrow(%x) : $@differentiable(reverse) @callee_guaranteed (Double) -> Double
  end_borrow %first_borrow : $@differentiable(reverse) @callee_guaranteed (Double) -> Double
  destroy_value %first : $@differentiable(reverse) @callee_guaranteed (Double) -> Double
  %second_borrow = begin_borrow %second : $@differentiable(reverse) @callee_guaranteed (Double) -> Double
  %value2 = apply %second_borrow(%x) : $@differentiable(reverse) @callee_guaranteed (Double) -> Double
  end_borrow %second_borrow : $@differentiable(reverse) @callee_guaranteed (Double) -> Double
  destroy_value %second : $@differentiable(reverse) @callee_guaranteed (Double) -> Double
  %result = tuple (%value1 : $Double, %value2 : $Double)
  return %result : $(Double, Double)
}

sil [ossa] @duplicate_guaranteed_root : $@convention(thin) (Double) -> (Double, Double) {
bb0(%x : $Double):
  %original_ref = function_ref @primal : $@convention(thin) (Double) -> Double
  %a_ref = function_ref @derivative_a : $@convention(thin) (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double)
  %b_ref = function_ref @derivative_b : $@convention(thin) (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double)
  %original = thin_to_thick_function %original_ref : $@convention(thin) (Double) -> Double to $@callee_guaranteed (Double) -> Double
  %a = thin_to_thick_function %a_ref : $@convention(thin) (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double) to $@callee_guaranteed (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double)
  %b = thin_to_thick_function %b_ref : $@convention(thin) (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double) to $@callee_guaranteed (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double)
  %function = differentiable_function [parameters 0] [results 0] %original : $@callee_guaranteed (Double) -> Double with_derivative {%a : $@callee_guaranteed (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double), %b : $@callee_guaranteed (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double)}
  %consumer = function_ref @take_two_guaranteed : $@convention(thin) (Double, @guaranteed @differentiable(reverse) @callee_guaranteed (Double) -> Double, @guaranteed @differentiable(reverse) @callee_guaranteed (Double) -> Double) -> (Double, Double)
  %result = apply %consumer(%x, %function, %function) : $@convention(thin) (Double, @guaranteed @differentiable(reverse) @callee_guaranteed (Double) -> Double, @guaranteed @differentiable(reverse) @callee_guaranteed (Double) -> Double) -> (Double, Double)
  return %result : $(Double, Double)
}

// No begin_borrow is needed when the cloned root still has ownership none.
// TWO-GUARANTEED-LABEL: sil shared [noinline] [ossa] @$s19take_two_guaranteed{{[^ ]*}} : $@convention(thin) (Double) -> (Double, Double) {
// TWO-GUARANTEED-NOT: begin_borrow
// TWO-GUARANTEED-NOT: copy_value
// TWO-GUARANTEED: %[[ROOT:[0-9]+]] = differentiable_function
// TWO-GUARANTEED-SAME: ownership: none
// TWO-GUARANTEED-NEXT: %{{[0-9]+}} = apply %[[ROOT]]
// TWO-GUARANTEED-NEXT: %{{[0-9]+}} = apply %[[ROOT]]
// TWO-GUARANTEED-NOT: begin_borrow
// TWO-GUARANTEED-NOT: copy_value
// TWO-GUARANTEED-NOT: destroy_value
// TWO-GUARANTEED-LABEL: } // end sil function
sil [noinline] [ossa] @take_two_guaranteed : $@convention(thin) (Double, @guaranteed @differentiable(reverse) @callee_guaranteed (Double) -> Double, @guaranteed @differentiable(reverse) @callee_guaranteed (Double) -> Double) -> (Double, Double) {
bb0(%x : $Double, %first : @guaranteed $@differentiable(reverse) @callee_guaranteed (Double) -> Double, %second : @guaranteed $@differentiable(reverse) @callee_guaranteed (Double) -> Double):
  %value1 = apply %first(%x) : $@differentiable(reverse) @callee_guaranteed (Double) -> Double
  %value2 = apply %second(%x) : $@differentiable(reverse) @callee_guaranteed (Double) -> Double
  %result = tuple (%value1 : $Double, %value2 : $Double)
  return %result : $(Double, Double)
}

sil [ossa] @mixed_root : $@convention(thin) (Double) -> (Double, Double) {
bb0(%x : $Double):
  %original_ref = function_ref @primal : $@convention(thin) (Double) -> Double
  %a_ref = function_ref @derivative_a : $@convention(thin) (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double)
  %b_ref = function_ref @derivative_b : $@convention(thin) (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double)
  %original = thin_to_thick_function %original_ref : $@convention(thin) (Double) -> Double to $@callee_guaranteed (Double) -> Double
  %a = thin_to_thick_function %a_ref : $@convention(thin) (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double) to $@callee_guaranteed (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double)
  %b = thin_to_thick_function %b_ref : $@convention(thin) (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double) to $@callee_guaranteed (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double)
  %function = differentiable_function [parameters 0] [results 0] %original : $@callee_guaranteed (Double) -> Double with_derivative {%a : $@callee_guaranteed (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double), %b : $@callee_guaranteed (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double)}
  %consumer = function_ref @take_mixed : $@convention(thin) (Double, @owned @differentiable(reverse) @callee_guaranteed (Double) -> Double, @guaranteed @differentiable(reverse) @callee_guaranteed (Double) -> Double) -> (Double, Double)
  %result = apply %consumer(%x, %function, %function) : $@convention(thin) (Double, @owned @differentiable(reverse) @callee_guaranteed (Double) -> Double, @guaranteed @differentiable(reverse) @callee_guaranteed (Double) -> Double) -> (Double, Double)
  return %result : $(Double, Double)
}

// The none root can serve an owned and a guaranteed formal without a new copy.
// The ordinary body cloner handles ownership-independent uses of that root.
// MIXED-LABEL: sil shared [noinline] [ossa] @$s10take_mixed{{[^ ]*}} : $@convention(thin) (Double) -> (Double, Double) {
// MIXED-NOT: copy_value
// MIXED: %[[ROOT:[0-9]+]] = differentiable_function
// MIXED-SAME: ownership: none
// MIXED-NOT: copy_value
// MIXED: return
// MIXED-NOT: copy_value
// MIXED-LABEL: } // end sil function
sil [noinline] [ossa] @take_mixed : $@convention(thin) (Double, @owned @differentiable(reverse) @callee_guaranteed (Double) -> Double, @guaranteed @differentiable(reverse) @callee_guaranteed (Double) -> Double) -> (Double, Double) {
bb0(%x : $Double, %owned : @owned $@differentiable(reverse) @callee_guaranteed (Double) -> Double, %guaranteed : @guaranteed $@differentiable(reverse) @callee_guaranteed (Double) -> Double):
  %borrow = begin_borrow %owned : $@differentiable(reverse) @callee_guaranteed (Double) -> Double
  %value1 = apply %borrow(%x) : $@differentiable(reverse) @callee_guaranteed (Double) -> Double
  end_borrow %borrow : $@differentiable(reverse) @callee_guaranteed (Double) -> Double
  destroy_value %owned : $@differentiable(reverse) @callee_guaranteed (Double) -> Double
  %value2 = apply %guaranteed(%x) : $@differentiable(reverse) @callee_guaranteed (Double) -> Double
  %result = tuple (%value1 : $Double, %value2 : $Double)
  return %result : $(Double, Double)
}

// Merely returning the bundle gives no opportunity to specialize an invocation
// inside the callee. Keep this call unspecialized even though the argument's
// three components are known and its ownership is none.
// RETURN-ONLY-LABEL: sil [ossa] @return_only_caller :
// RETURN-ONLY: %[[ROOT:[0-9]+]] = differentiable_function
// RETURN-ONLY: %[[CALLEE:[0-9]+]] = function_ref @return_bundle :
// RETURN-ONLY: %[[RETURNED:[0-9]+]] = apply %[[CALLEE]](%[[ROOT]])
// RETURN-ONLY: return %[[RETURNED]]
// RETURN-ONLY-LABEL: } // end sil function
sil [ossa] @return_only_caller : $@convention(thin) () -> @owned @differentiable(reverse) @callee_guaranteed (Double) -> Double {
bb0:
  %original_ref = function_ref @primal : $@convention(thin) (Double) -> Double
  %a_ref = function_ref @derivative_a : $@convention(thin) (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double)
  %b_ref = function_ref @derivative_b : $@convention(thin) (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double)
  %original = thin_to_thick_function %original_ref : $@convention(thin) (Double) -> Double to $@callee_guaranteed (Double) -> Double
  %a = thin_to_thick_function %a_ref : $@convention(thin) (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double) to $@callee_guaranteed (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double)
  %b = thin_to_thick_function %b_ref : $@convention(thin) (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double) to $@callee_guaranteed (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double)
  %function = differentiable_function [parameters 0] [results 0] %original : $@callee_guaranteed (Double) -> Double with_derivative {%a : $@callee_guaranteed (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double), %b : $@callee_guaranteed (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double)}
  %consumer = function_ref @return_bundle : $@convention(thin) (@owned @differentiable(reverse) @callee_guaranteed (Double) -> Double) -> @owned @differentiable(reverse) @callee_guaranteed (Double) -> Double
  %returned = apply %consumer(%function) : $@convention(thin) (@owned @differentiable(reverse) @callee_guaranteed (Double) -> Double) -> @owned @differentiable(reverse) @callee_guaranteed (Double) -> Double
  return %returned : $@differentiable(reverse) @callee_guaranteed (Double) -> Double
}

sil [noinline] [ossa] @return_bundle : $@convention(thin) (@owned @differentiable(reverse) @callee_guaranteed (Double) -> Double) -> @owned @differentiable(reverse) @callee_guaranteed (Double) -> Double {
bb0(%function : @owned $@differentiable(reverse) @callee_guaranteed (Double) -> Double):
  return %function : $@differentiable(reverse) @callee_guaranteed (Double) -> Double
}

// An ownership-none convert_function outside the aggregate stays ownership
// none when its complete expression is cloned. No conversion repair is needed.
// This isolates outer conversions from the component conversions in Swift case 2.
sil [ossa] @converted_root : $@convention(thin) (Double) -> Double {
bb0(%x : $Double):
  %original_ref = function_ref @primal : $@convention(thin) (Double) -> Double
  %a_ref = function_ref @derivative_a : $@convention(thin) (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double)
  %b_ref = function_ref @derivative_b : $@convention(thin) (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double)
  %original = thin_to_thick_function %original_ref : $@convention(thin) (Double) -> Double to $@callee_guaranteed (Double) -> Double
  %a = thin_to_thick_function %a_ref : $@convention(thin) (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double) to $@callee_guaranteed (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double)
  %b = thin_to_thick_function %b_ref : $@convention(thin) (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double) to $@callee_guaranteed (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double)
  %function = differentiable_function [parameters 0] [results 0] %original : $@callee_guaranteed (Double) -> Double with_derivative {%a : $@callee_guaranteed (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double), %b : $@callee_guaranteed (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double)}
  %converted = convert_function %function : $@differentiable(reverse) @callee_guaranteed (Double) -> Double to $@differentiable(reverse) @callee_guaranteed (Double) -> Double
  %consumer = function_ref @apply_converted : $@convention(thin) (Double, @guaranteed @differentiable(reverse) @callee_guaranteed (Double) -> Double) -> Double
  %result = apply %consumer(%x, %converted) : $@convention(thin) (Double, @guaranteed @differentiable(reverse) @callee_guaranteed (Double) -> Double) -> Double
  return %result : $Double
}

// OUTER-CONVERT-LABEL: sil shared [noinline] [ossa] @$s15apply_converted{{[^ ]*}} : $@convention(thin) (Double) -> Double {
// OUTER-CONVERT-NOT: copy_value
// OUTER-CONVERT: %[[ROOT:[0-9]+]] = differentiable_function
// OUTER-CONVERT-SAME: ownership: none
// OUTER-CONVERT-NEXT: %[[CONVERTED:[0-9]+]] = convert_function %[[ROOT]] to $@differentiable(reverse) @callee_guaranteed (Double) -> Double
// OUTER-CONVERT-SAME: ownership: none
// OUTER-CONVERT-NEXT: %{{[0-9]+}} = apply %[[CONVERTED]]
// OUTER-CONVERT-NOT: copy_value
// OUTER-CONVERT-NOT: begin_borrow
