bb0(%x : $Double, %owned : @owned $@differentiable(reverse) @callee_guaranteed (Double) -> Double, %guaranteed : @guaranteed $@differentiable(reverse) @callee_guaranteed (Double) -> Double):
  %borrow = begin_borrow %owned : $@differentiable(reverse) @callee_guaranteed (Double) -> Double
  %value1 = apply %borrow(%x) : $@differentiable(reverse) @callee_guaranteed (Double) -> Double
  end_borrow %borrow : $@differentiable(reverse) @callee_guaranteed (Double) -> Double
  destroy_value %owned : $@differentiable(reverse) @callee_guaranteed (Double) -> Double
  %value2 = apply %guaranteed(%x) : $@differentiable(reverse) @callee_guaranteed (Double) -> Double
  %result = tuple (%value1 : $Double, %value2 : $Double)
  return %result : $(Double, Double)
}

// Merely returning the bundle gives no opportunity to specialize an invocation
// inside the callee. Keep this call unspecialized even though the argument's
// three components are known and its ownership is none.
// RETURN-ONLY-LABEL: sil [ossa] @return_only_caller :
// RETURN-ONLY: %[[ROOT:[0-9]+]] = differentiable_function
// RETURN-ONLY: %[[CALLEE:[0-9]+]] = function_ref @return_bundle :
// RETURN-ONLY: %[[RETURNED:[0-9]+]] = apply %[[CALLEE]](%[[ROOT]])
// RETURN-ONLY: return %[[RETURNED]]
// RETURN-ONLY-LABEL: } // end sil function
sil [ossa] @return_only_caller : $@convention(thin) () -> @owned @differentiable(reverse) @callee_guaranteed (Double) -> Double {
bb0:
  %original_ref = function_ref @primal : $@convention(thin) (Double) -> Double
  %a_ref = function_ref @derivative_a : $@convention(thin) (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double)
  %b_ref = function_ref @derivative_b : $@convention(thin) (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double)
  %original = thin_to_thick_function %original_ref : $@convention(thin) (Double) -> Double to $@callee_guaranteed (Double) -> Double
  %a = thin_to_thick_function %a_ref : $@convention(thin) (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double) to $@callee_guaranteed (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double)
  %b = thin_to_thick_function %b_ref : $@convention(thin) (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double) to $@callee_guaranteed (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double)
  %function = differentiable_function [parameters 0] [results 0] %original : $@callee_guaranteed (Double) -> Double with_derivative {%a : $@callee_guaranteed (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double), %b : $@callee_guaranteed (Double) -> (Double, @owned @callee_guaranteed (Double) -> Double)}
  %consumer = function_ref @return_bundle : $@convention(thin) (@owned @differentiable(reverse) @callee_guaranteed (Double) -> Double) -> @owned @differentiable(reverse) @callee_guaranteed (Double) -> Double
  %returned = apply %consumer(%function) : $@convention(thin) (@owned @differentiable(reverse) @callee_guaranteed (Double) -> Double) -> @owned @differentiable(reverse) @callee_guaranteed (Double) -> Double
  return %returned : $@differentiable(reverse) @callee_guaranteed (Double) -> Double
}

sil [noinline] [ossa] @return_bundle : $@convention(thin) (@owned @differentiable(reverse) @callee_guaranteed (Double) -> Double) -> @owned @differentiable(reverse) @callee_guaranteed (Double) -> Double {
bb0(%function : @owned $@differentiable(reverse) @callee_guaranteed (Double) -> Double):
  return %function : $@differentiable(reverse) @callee_guaranteed (Double) -> Double
}

// An ownership-none convert_function outside the aggregate must be rebuilt
