// RUN: %target-sil-opt -sil-print-types -enable-sil-verify-all -closure-specialization -module-name ClosureUseSearch %s | %FileCheck %s --check-prefixes=ORDINARY,THUNK,NEGATIVE
//
// Literal pre-pass SIL generated from closure_specialization_continue_use_search.swift:
//   %target-swift-frontend -emit-sil -O -parse-as-library -module-name ClosureUseSearch -Xllvm -sil-print-around=closure-specialization %S/closure_specialization_continue_use_search.swift
//
// The bodies below are copied verbatim from the first ClosureSpecialize-stage
// pre-pass dumps, together with their transitive function dependencies. Only
// unrelated function definitions are omitted. No instructions, types, ownership,
// attributes, operand order, debug information, or control flow were changed.
//
// The returned ordinary wrapper and reabstraction thunk are not applied inside
// their respective callees. Searching either must continue to the direct apply.
// deferOnly is the negative case: it captures a callback but never applies it.

// ORDINARY-LABEL: sil {{.*}}@$s16ClosureUseSearch6update{{.*}} :
// ORDINARY-NOT: partial_apply
// ORDINARY: function_ref @{{.*}}11runAndDefer{{.*}}Tf1{{.*}} : $@convention(thin) (Float, Float)
// ORDINARY-NOT: partial_apply
// ORDINARY: apply
// ORDINARY-NEXT: return
// THUNK-LABEL: sil {{.*}}@$s16ClosureUseSearch9updateBox{{.*}} :
// THUNK-NOT: partial_apply
// THUNK: function_ref @{{.*}}9runAndBox{{.*}}Tf1{{.*}} : $@convention(thin) (Float, Float)
// THUNK-NOT: partial_apply
// THUNK: apply
// THUNK-NEXT: return
// NEGATIVE-LABEL: sil {{.*}}@$s16ClosureUseSearch12unusedUpdate{{.*}} :
// NEGATIVE: partial_apply
// NEGATIVE: function_ref @{{.*}}9deferOnly{{.*}} : $@convention(thin) (@owned @callee_guaranteed (Float) -> Float)
// NEGATIVE: apply
// NEGATIVE-NEXT: return

sil_stage canonical

import Builtin
import Swift
import SwiftShims

@inline(never) public func runAndDefer(_ value: Float, _ body: consuming @escaping (Float) -> Float) -> (Float, (Float) -> Float)

public func update(_ value: Float, _ factor: Float) -> (Float, (Float) -> Float)

public struct CallbackBox<T> {
  @_hasStorage public var body: (T) -> T { get set }
  init(body: @escaping (T) -> T)
}

@inline(never) public func runAndBox(_ value: Float, _ body: consuming @escaping (Float) -> Float) -> (Float, CallbackBox<Float>)

public func updateBox(_ value: Float, _ factor: Float) -> (Float, CallbackBox<Float>)

@inline(never) public func deferOnly(_ body: consuming @escaping (Float) -> Float) -> (Float) -> Float

public func unusedUpdate(_ factor: Float) -> (Float) -> Float

