// RUN: %target-sil-opt -enable-sil-verify-all %s -simplification -simplify-instruction=begin_borrow | %FileCheck %s --check-prefix=CHECK --check-prefix=OPT
// RUN: %target-sil-opt -enable-sil-verify-all %s -onone-simplification -simplify-instruction=begin_borrow | %FileCheck %s --check-prefix=CHECK --check-prefix=ONONE

sil_stage canonical

import Builtin
import Swift

sil @captureInt : $@convention(thin) (Int) -> Int
sil @captureObject : $@convention(thin) (@guaranteed Builtin.NativeObject) -> Int
sil @makeClosure : $@convention(thin) () -> @owned @callee_guaranteed () -> Int
sil @consumeThrowing : $@convention(thin) (@guaranteed @noescape @callee_guaranteed () -> (Int, @error any Error)) -> (Int, @error any Error)
sil @consumeNonthrowing : $@convention(thin) (@guaranteed @noescape @callee_guaranteed () -> Int) -> Int
sil @consumeCatching : $@convention(thin) (@guaranteed @noescape @callee_guaranteed () -> (Int, @error any Error)) -> Int
sil @observeClosure : $@convention(thin) (@guaranteed @callee_guaranteed () -> Int) -> ()
sil @observeThrowingClosure : $@convention(thin) (@guaranteed @callee_guaranteed () -> (Int, @error any Error)) -> ()
sil @touchInt : $@convention(thin) (@inout Int) -> ()

// Remove a conversion borrow despite the debug use of its owner.
// Redirect the owner destroys on both exits; do not shorten either lifetime.
// The -Onone run must preserve the original borrow and guaranteed conversion.
// CHECK-LABEL:{{^}}sil [ossa] @borrow_throwing_debug :
// CHECK:          %[[#OWNER:]] = partial_apply [callee_guaranteed] %[[#]](%[[#]])
// CHECK-NEXT:     debug_value %[[#OWNER]], let, name "f"
// ONONE-NEXT:     %[[#BORROW:]] = begin_borrow %[[#OWNER]]
// OPT-NEXT:       %[[#CONVERTED:]] = convert_function %[[#OWNER]] to $@callee_guaranteed () -> (Int, @error any Error)
// ONONE-NEXT:     %[[#CONVERTED:]] = convert_function %[[#BORROW]] to $@callee_guaranteed () -> (Int, @error any Error)
// CHECK-NEXT:     %[[#NOESCAPE:]] = convert_escape_to_noescape %[[#CONVERTED]] to $@noescape @callee_guaranteed () -> (Int, @error any Error)
// CHECK:          %[[#USE:]] = function_ref @consumeThrowing :
// CHECK-NEXT:     try_apply %[[#USE]](%[[#NOESCAPE]])
// CHECK:        bb1(%[[#RESULT:]] : $Int):
// CHECK-NEXT:     destroy_value %[[#NOESCAPE]]{{( |$)}}
// ONONE-NEXT:     end_borrow %[[#BORROW]]{{( |$)}}
// OPT-NEXT:       destroy_value %[[#CONVERTED]]{{( |$)}}
// ONONE-NEXT:     destroy_value %[[#OWNER]]{{( |$)}}
// CHECK-NEXT:     return %[[#RESULT]]{{( |$)}}
// CHECK:        bb2(%[[#ERROR:]] : @owned $any Error):
// CHECK-NEXT:     destroy_value %[[#NOESCAPE]]{{( |$)}}
// ONONE-NEXT:     end_borrow %[[#BORROW]]{{( |$)}}
// OPT-NEXT:       destroy_value %[[#CONVERTED]]{{( |$)}}
// ONONE-NEXT:     destroy_value %[[#OWNER]]{{( |$)}}
// CHECK-NEXT:     throw %[[#ERROR]]{{( |$)}}
// CHECK-NEXT:   {{^}}} // end sil function 'borrow_throwing_debug'
sil [ossa] @borrow_throwing_debug : $@convention(thin) (Int) -> (Int, @error any Error) {
bb0(%0 : $Int):
  %1 = function_ref @captureInt : $@convention(thin) (Int) -> Int
  %2 = partial_apply [callee_guaranteed] %1(%0) : $@convention(thin) (Int) -> Int
  debug_value %2, let, name "f"
  %3 = begin_borrow %2
  %4 = convert_function %3 to $@callee_guaranteed () -> (Int, @error any Error)
  %5 = convert_escape_to_noescape %4 to $@noescape @callee_guaranteed () -> (Int, @error any Error)
  %6 = function_ref @consumeThrowing : $@convention(thin) (@guaranteed @noescape @callee_guaranteed () -> (Int, @error any Error)) -> (Int, @error any Error)
  try_apply %6(%5) : $@convention(thin) (@guaranteed @noescape @callee_guaranteed () -> (Int, @error any Error)) -> (Int, @error any Error), normal bb1, error bb2

bb1(%7 : $Int):
  destroy_value %5
  end_borrow %3
  destroy_value %2
  return %7

bb2(%8 : @owned $any Error):
  destroy_value %5
  end_borrow %3
  destroy_value %2
  throw %8
}

// The same conversion does not require a debug use.
// CHECK-LABEL:{{^}}sil [ossa] @borrow_throwing_plain :
// CHECK:          %[[#OWNER:]] = partial_apply [callee_guaranteed] %[[#]](%[[#]])
// ONONE-NEXT:     %[[#BORROW:]] = begin_borrow %[[#OWNER]]
// OPT-NEXT:       %[[#CONVERTED:]] = convert_function %[[#OWNER]] to $@callee_guaranteed () -> (Int, @error any Error)
// ONONE-NEXT:     %[[#CONVERTED:]] = convert_function %[[#BORROW]] to $@callee_guaranteed () -> (Int, @error any Error)
// CHECK-NEXT:     %[[#NOESCAPE:]] = convert_escape_to_noescape %[[#CONVERTED]] to $@noescape @callee_guaranteed () -> (Int, @error any Error)
// CHECK:          %[[#USE:]] = function_ref @consumeThrowing :
// CHECK-NEXT:     try_apply %[[#USE]](%[[#NOESCAPE]])
// CHECK:        bb1(%[[#RESULT:]] : $Int):
// CHECK-NEXT:     destroy_value %[[#NOESCAPE]]{{( |$)}}
// ONONE-NEXT:     end_borrow %[[#BORROW]]{{( |$)}}
// OPT-NEXT:       destroy_value %[[#CONVERTED]]{{( |$)}}
// ONONE-NEXT:     destroy_value %[[#OWNER]]{{( |$)}}
// CHECK-NEXT:     return %[[#RESULT]]{{( |$)}}
// CHECK:        bb2(%[[#ERROR:]] : @owned $any Error):
// CHECK-NEXT:     destroy_value %[[#NOESCAPE]]{{( |$)}}
// ONONE-NEXT:     end_borrow %[[#BORROW]]{{( |$)}}
// OPT-NEXT:       destroy_value %[[#CONVERTED]]{{( |$)}}
// ONONE-NEXT:     destroy_value %[[#OWNER]]{{( |$)}}
// CHECK-NEXT:     throw %[[#ERROR]]{{( |$)}}
// CHECK-NEXT:   {{^}}} // end sil function 'borrow_throwing_plain'
sil [ossa] @borrow_throwing_plain : $@convention(thin) (Int) -> (Int, @error any Error) {
bb0(%0 : $Int):
  %1 = function_ref @captureInt : $@convention(thin) (Int) -> Int
  %2 = partial_apply [callee_guaranteed] %1(%0) : $@convention(thin) (Int) -> Int
  %3 = begin_borrow %2
  %4 = convert_function %3 to $@callee_guaranteed () -> (Int, @error any Error)
  %5 = convert_escape_to_noescape %4 to $@noescape @callee_guaranteed () -> (Int, @error any Error)
  %6 = function_ref @consumeThrowing : $@convention(thin) (@guaranteed @noescape @callee_guaranteed () -> (Int, @error any Error)) -> (Int, @error any Error)
  try_apply %6(%5) : $@convention(thin) (@guaranteed @noescape @callee_guaranteed () -> (Int, @error any Error)) -> (Int, @error any Error), normal bb1, error bb2

bb1(%7 : $Int):
  destroy_value %5
  end_borrow %3
  destroy_value %2
  return %7

bb2(%8 : @owned $any Error):
  destroy_value %5
  end_borrow %3
  destroy_value %2
  throw %8
}

// Without convert_function, removing the borrow leaves destroys on its owner.
// CHECK-LABEL:{{^}}sil [ossa] @borrow_nonthrowing_direct :
// CHECK:          %[[#OWNER:]] = partial_apply [callee_guaranteed] %[[#]](%[[#]])
// ONONE-NEXT:     %[[#BORROW:]] = begin_borrow %[[#OWNER]]
// OPT-NEXT:       %[[#NOESCAPE:]] = convert_escape_to_noescape %[[#OWNER]] to $@noescape @callee_guaranteed () -> Int
// ONONE-NEXT:     %[[#NOESCAPE:]] = convert_escape_to_noescape %[[#BORROW]] to $@noescape @callee_guaranteed () -> Int
// CHECK:          %[[#USE:]] = function_ref @consumeNonthrowing :
// CHECK-NEXT:     %[[#RESULT:]] = apply %[[#USE]](%[[#NOESCAPE]])
// CHECK-NEXT:     destroy_value %[[#NOESCAPE]]{{( |$)}}
// ONONE-NEXT:     end_borrow %[[#BORROW]]{{( |$)}}
// OPT-NEXT:       destroy_value %[[#OWNER]]{{( |$)}}
// ONONE-NEXT:     destroy_value %[[#OWNER]]{{( |$)}}
// CHECK-NEXT:     return %[[#RESULT]]{{( |$)}}
// CHECK-NEXT:   {{^}}} // end sil function 'borrow_nonthrowing_direct'
sil [ossa] @borrow_nonthrowing_direct : $@convention(thin) (Int) -> Int {
bb0(%0 : $Int):
  %1 = function_ref @captureInt : $@convention(thin) (Int) -> Int
  %2 = partial_apply [callee_guaranteed] %1(%0) : $@convention(thin) (Int) -> Int
  %3 = begin_borrow %2
  %4 = convert_escape_to_noescape %3 to $@noescape @callee_guaranteed () -> Int
  %5 = function_ref @consumeNonthrowing : $@convention(thin) (@guaranteed @noescape @callee_guaranteed () -> Int) -> Int
  %6 = apply %5(%4) : $@convention(thin) (@guaranteed @noescape @callee_guaranteed () -> Int) -> Int
  destroy_value %4
  end_borrow %3
  destroy_value %2
  return %6
}

// A nontrivial capture must remain owned by the converted closure context.
// CHECK-LABEL:{{^}}sil [ossa] @borrow_throwing_reference :
// CHECK:          %[[#OWNER:]] = partial_apply [callee_guaranteed] %[[#]](%[[#]])
// ONONE-NEXT:     %[[#BORROW:]] = begin_borrow %[[#OWNER]]
// OPT-NEXT:       %[[#CONVERTED:]] = convert_function %[[#OWNER]] to $@callee_guaranteed () -> (Int, @error any Error)
// ONONE-NEXT:     %[[#CONVERTED:]] = convert_function %[[#BORROW]] to $@callee_guaranteed () -> (Int, @error any Error)
// CHECK-NEXT:     %[[#NOESCAPE:]] = convert_escape_to_noescape %[[#CONVERTED]] to $@noescape @callee_guaranteed () -> (Int, @error any Error)
// CHECK:          %[[#USE:]] = function_ref @consumeThrowing :
// CHECK-NEXT:     try_apply %[[#USE]](%[[#NOESCAPE]])
// CHECK:        bb1(%[[#RESULT:]] : $Int):
// CHECK-NEXT:     destroy_value %[[#NOESCAPE]]{{( |$)}}
// ONONE-NEXT:     end_borrow %[[#BORROW]]{{( |$)}}
// OPT-NEXT:       destroy_value %[[#CONVERTED]]{{( |$)}}
// ONONE-NEXT:     destroy_value %[[#OWNER]]{{( |$)}}
// CHECK-NEXT:     return %[[#RESULT]]{{( |$)}}
// CHECK:        bb2(%[[#ERROR:]] : @owned $any Error):
// CHECK-NEXT:     destroy_value %[[#NOESCAPE]]{{( |$)}}
// ONONE-NEXT:     end_borrow %[[#BORROW]]{{( |$)}}
// OPT-NEXT:       destroy_value %[[#CONVERTED]]{{( |$)}}
// ONONE-NEXT:     destroy_value %[[#OWNER]]{{( |$)}}
// CHECK-NEXT:     throw %[[#ERROR]]{{( |$)}}
// CHECK-NEXT:   {{^}}} // end sil function 'borrow_throwing_reference'
sil [ossa] @borrow_throwing_reference : $@convention(thin) (@owned Builtin.NativeObject) -> (Int, @error any Error) {
bb0(%0 : @owned $Builtin.NativeObject):
  %1 = function_ref @captureObject : $@convention(thin) (@guaranteed Builtin.NativeObject) -> Int
  %2 = partial_apply [callee_guaranteed] %1(%0) : $@convention(thin) (@guaranteed Builtin.NativeObject) -> Int
  %3 = begin_borrow %2
  %4 = convert_function %3 to $@callee_guaranteed () -> (Int, @error any Error)
  %5 = convert_escape_to_noescape %4 to $@noescape @callee_guaranteed () -> (Int, @error any Error)
  %6 = function_ref @consumeThrowing : $@convention(thin) (@guaranteed @noescape @callee_guaranteed () -> (Int, @error any Error)) -> (Int, @error any Error)
  try_apply %6(%5) : $@convention(thin) (@guaranteed @noescape @callee_guaranteed () -> (Int, @error any Error)) -> (Int, @error any Error), normal bb1, error bb2

bb1(%7 : $Int):
  destroy_value %5
  end_borrow %3
  destroy_value %2
  return %7

bb2(%8 : @owned $any Error):
  destroy_value %5
  end_borrow %3
  destroy_value %2
  throw %8
}

// The owner can be an apply result, not only a partial_apply.
// CHECK-LABEL:{{^}}sil [ossa] @borrow_throwing_factory :
// CHECK:          %[[#OWNER:]] = apply %[[#]]()
// ONONE-NEXT:     %[[#BORROW:]] = begin_borrow %[[#OWNER]]
// OPT-NEXT:       %[[#CONVERTED:]] = convert_function %[[#OWNER]] to $@callee_guaranteed () -> (Int, @error any Error)
// ONONE-NEXT:     %[[#CONVERTED:]] = convert_function %[[#BORROW]] to $@callee_guaranteed () -> (Int, @error any Error)
// CHECK-NEXT:     %[[#NOESCAPE:]] = convert_escape_to_noescape %[[#CONVERTED]] to $@noescape @callee_guaranteed () -> (Int, @error any Error)
// CHECK:          %[[#USE:]] = function_ref @consumeThrowing :
// CHECK-NEXT:     try_apply %[[#USE]](%[[#NOESCAPE]])
// CHECK:        bb1(%[[#RESULT:]] : $Int):
// CHECK-NEXT:     destroy_value %[[#NOESCAPE]]{{( |$)}}
// ONONE-NEXT:     end_borrow %[[#BORROW]]{{( |$)}}
// OPT-NEXT:       destroy_value %[[#CONVERTED]]{{( |$)}}
// ONONE-NEXT:     destroy_value %[[#OWNER]]{{( |$)}}
// CHECK-NEXT:     return %[[#RESULT]]{{( |$)}}
// CHECK:        bb2(%[[#ERROR:]] : @owned $any Error):
// CHECK-NEXT:     destroy_value %[[#NOESCAPE]]{{( |$)}}
// ONONE-NEXT:     end_borrow %[[#BORROW]]{{( |$)}}
// OPT-NEXT:       destroy_value %[[#CONVERTED]]{{( |$)}}
// ONONE-NEXT:     destroy_value %[[#OWNER]]{{( |$)}}
// CHECK-NEXT:     throw %[[#ERROR]]{{( |$)}}
// CHECK-NEXT:   {{^}}} // end sil function 'borrow_throwing_factory'
sil [ossa] @borrow_throwing_factory : $@convention(thin) () -> (Int, @error any Error) {
bb0:
  %0 = function_ref @makeClosure : $@convention(thin) () -> @owned @callee_guaranteed () -> Int
  %1 = apply %0() : $@convention(thin) () -> @owned @callee_guaranteed () -> Int
  %2 = begin_borrow %1
  %3 = convert_function %2 to $@callee_guaranteed () -> (Int, @error any Error)
  %4 = convert_escape_to_noescape %3 to $@noescape @callee_guaranteed () -> (Int, @error any Error)
  %5 = function_ref @consumeThrowing : $@convention(thin) (@guaranteed @noescape @callee_guaranteed () -> (Int, @error any Error)) -> (Int, @error any Error)
  try_apply %5(%4) : $@convention(thin) (@guaranteed @noescape @callee_guaranteed () -> (Int, @error any Error)) -> (Int, @error any Error), normal bb1, error bb2

bb1(%6 : $Int):
  destroy_value %4
  end_borrow %2
  destroy_value %1
  return %6

bb2(%7 : @owned $any Error):
  destroy_value %4
  end_borrow %2
  destroy_value %1
  throw %7
}

// Preserve ordinary and dead-end destroys at their original positions.
// CHECK-LABEL:{{^}}sil [ossa] @borrow_nonthrowing_dead_end :
// CHECK:          %[[#OWNER:]] = partial_apply [callee_guaranteed] %[[#]](%[[#]])
// ONONE-NEXT:     %[[#BORROW:]] = begin_borrow %[[#OWNER]]
// OPT-NEXT:       %[[#NOESCAPE:]] = convert_escape_to_noescape %[[#OWNER]] to $@noescape @callee_guaranteed () -> Int
// ONONE-NEXT:     %[[#NOESCAPE:]] = convert_escape_to_noescape %[[#BORROW]] to $@noescape @callee_guaranteed () -> Int
// CHECK:          %[[#USE:]] = function_ref @consumeNonthrowing :
// CHECK-NEXT:     %[[#RESULT:]] = apply %[[#USE]](%[[#NOESCAPE]])
// CHECK-NEXT:     cond_br %[[#]], bb1, bb2
// CHECK:        bb1:
// CHECK-NEXT:     destroy_value %[[#NOESCAPE]]{{( |$)}}
// ONONE-NEXT:     end_borrow %[[#BORROW]]{{( |$)}}
// OPT-NEXT:       destroy_value %[[#OWNER]]{{( |$)}}
// ONONE-NEXT:     destroy_value %[[#OWNER]]{{( |$)}}
// CHECK-NEXT:     return %[[#RESULT]]{{( |$)}}
// CHECK:        bb2:
// CHECK-NEXT:     destroy_value [dead_end] %[[#NOESCAPE]]{{( |$)}}
// ONONE-NEXT:     end_borrow %[[#BORROW]]{{( |$)}}
// OPT-NEXT:       destroy_value [dead_end] %[[#OWNER]]{{( |$)}}
// ONONE-NEXT:     destroy_value [dead_end] %[[#OWNER]]{{( |$)}}
// CHECK-NEXT:     unreachable
// CHECK-NEXT:   {{^}}} // end sil function 'borrow_nonthrowing_dead_end'
sil [ossa] @borrow_nonthrowing_dead_end : $@convention(thin) (Int, Builtin.Int1) -> Int {
bb0(%0 : $Int, %1 : $Builtin.Int1):
  %2 = function_ref @captureInt : $@convention(thin) (Int) -> Int
  %3 = partial_apply [callee_guaranteed] %2(%0) : $@convention(thin) (Int) -> Int
  %4 = begin_borrow %3
  %5 = convert_escape_to_noescape %4 to $@noescape @callee_guaranteed () -> Int
  %6 = function_ref @consumeNonthrowing : $@convention(thin) (@guaranteed @noescape @callee_guaranteed () -> Int) -> Int
  %7 = apply %6(%5) : $@convention(thin) (@guaranteed @noescape @callee_guaranteed () -> Int) -> Int
  cond_br %1, bb1, bb2

bb1:
  destroy_value %5
  end_borrow %4
  destroy_value %3
  return %7

bb2:
  destroy_value [dead_end] %5
  end_borrow %4
  destroy_value [dead_end] %3
  unreachable
}

// Do not consume the owner in the conversion when the owner has another use.
// CHECK-LABEL:{{^}}sil [ossa] @keep_owner_other_use :
// CHECK:          %[[#OWNER:]] = partial_apply [callee_guaranteed] %[[#]](%[[#]])
// CHECK-NEXT:     %[[#BORROW:]] = begin_borrow %[[#OWNER]]
// CHECK-NEXT:     %[[#CONVERTED:]] = convert_function %[[#BORROW]] to $@callee_guaranteed () -> (Int, @error any Error)
// CHECK-NEXT:     %[[#NOESCAPE:]] = convert_escape_to_noescape %[[#CONVERTED]] to $@noescape @callee_guaranteed () -> (Int, @error any Error)
// CHECK:          destroy_value %[[#NOESCAPE]]{{( |$)}}
// CHECK-NEXT:     end_borrow %[[#BORROW]]{{( |$)}}
// CHECK:          %[[#OBSERVE:]] = function_ref @observeClosure :
// CHECK-NEXT:     apply %[[#OBSERVE]](%[[#OWNER]])
// CHECK-NEXT:     destroy_value %[[#OWNER]]{{( |$)}}
// CHECK:          return %[[#]]{{( |$)}}
// CHECK-NEXT:   {{^}}} // end sil function 'keep_owner_other_use'
sil [ossa] @keep_owner_other_use : $@convention(thin) (Int) -> Int {
bb0(%0 : $Int):
  %1 = function_ref @captureInt : $@convention(thin) (Int) -> Int
  %2 = partial_apply [callee_guaranteed] %1(%0) : $@convention(thin) (Int) -> Int
  %3 = begin_borrow %2
  %4 = convert_function %3 to $@callee_guaranteed () -> (Int, @error any Error)
  %5 = convert_escape_to_noescape %4 to $@noescape @callee_guaranteed () -> (Int, @error any Error)
  %6 = function_ref @consumeCatching : $@convention(thin) (@guaranteed @noescape @callee_guaranteed () -> (Int, @error any Error)) -> Int
  %7 = apply %6(%5) : $@convention(thin) (@guaranteed @noescape @callee_guaranteed () -> (Int, @error any Error)) -> Int
  destroy_value %5
  end_borrow %3
  %8 = function_ref @observeClosure : $@convention(thin) (@guaranteed @callee_guaranteed () -> Int) -> ()
  %9 = apply %8(%2) : $@convention(thin) (@guaranteed @callee_guaranteed () -> Int) -> ()
  destroy_value %2
  return %7
}

// A borrowed value with two semantic users is not a single forwarding chain.
// CHECK-LABEL:{{^}}sil [ossa] @keep_borrow_fork :
// CHECK:          %[[#OWNER:]] = partial_apply [callee_guaranteed] %[[#]](%[[#]])
// CHECK-NEXT:     %[[#BORROW:]] = begin_borrow %[[#OWNER]]
// CHECK-NEXT:     %[[#CONVERTED:]] = convert_function %[[#BORROW]] to $@callee_guaranteed () -> (Int, @error any Error)
// CHECK-NEXT:     %[[#NOESCAPE:]] = convert_escape_to_noescape %[[#CONVERTED]] to $@noescape @callee_guaranteed () -> (Int, @error any Error)
// CHECK-NEXT:     %[[#OTHER:]] = convert_escape_to_noescape %[[#BORROW]] to $@noescape @callee_guaranteed () -> Int
// CHECK:          destroy_value %[[#OTHER]]{{( |$)}}
// CHECK:          destroy_value %[[#NOESCAPE]]{{( |$)}}
// CHECK-NEXT:     end_borrow %[[#BORROW]]{{( |$)}}
// CHECK-NEXT:     destroy_value %[[#OWNER]]{{( |$)}}
// CHECK:          return %[[#]]{{( |$)}}
// CHECK-NEXT:   {{^}}} // end sil function 'keep_borrow_fork'
sil [ossa] @keep_borrow_fork : $@convention(thin) (Int) -> (Int, Int) {
bb0(%0 : $Int):
  %1 = function_ref @captureInt : $@convention(thin) (Int) -> Int
  %2 = partial_apply [callee_guaranteed] %1(%0) : $@convention(thin) (Int) -> Int
  %3 = begin_borrow %2
  %4 = convert_function %3 to $@callee_guaranteed () -> (Int, @error any Error)
  %5 = convert_escape_to_noescape %4 to $@noescape @callee_guaranteed () -> (Int, @error any Error)
  %6 = convert_escape_to_noescape %3 to $@noescape @callee_guaranteed () -> Int
  %7 = function_ref @consumeCatching : $@convention(thin) (@guaranteed @noescape @callee_guaranteed () -> (Int, @error any Error)) -> Int
  %8 = apply %7(%5) : $@convention(thin) (@guaranteed @noescape @callee_guaranteed () -> (Int, @error any Error)) -> Int
  %9 = function_ref @consumeNonthrowing : $@convention(thin) (@guaranteed @noescape @callee_guaranteed () -> Int) -> Int
  %10 = apply %9(%6) : $@convention(thin) (@guaranteed @noescape @callee_guaranteed () -> Int) -> Int
  destroy_value %6
  destroy_value %5
  end_borrow %3
  destroy_value %2
  %11 = tuple (%8, %10)
  return %11
}

// An intermediate conversion must not have another semantic use.
// CHECK-LABEL:{{^}}sil [ossa] @keep_conversion_other_use :
// CHECK:          %[[#OWNER:]] = partial_apply [callee_guaranteed] %[[#]](%[[#]])
// CHECK-NEXT:     %[[#BORROW:]] = begin_borrow %[[#OWNER]]
// CHECK-NEXT:     %[[#CONVERTED:]] = convert_function %[[#BORROW]] to $@callee_guaranteed () -> (Int, @error any Error)
// CHECK-NEXT:     %[[#NOESCAPE:]] = convert_escape_to_noescape %[[#CONVERTED]] to $@noescape @callee_guaranteed () -> (Int, @error any Error)
// CHECK:          %[[#OBSERVE:]] = function_ref @observeThrowingClosure :
// CHECK-NEXT:     apply %[[#OBSERVE]](%[[#CONVERTED]])
// CHECK:          destroy_value %[[#NOESCAPE]]{{( |$)}}
// CHECK-NEXT:     end_borrow %[[#BORROW]]{{( |$)}}
// CHECK-NEXT:     destroy_value %[[#OWNER]]{{( |$)}}
// CHECK:          return %[[#]]{{( |$)}}
// CHECK-NEXT:   {{^}}} // end sil function 'keep_conversion_other_use'
sil [ossa] @keep_conversion_other_use : $@convention(thin) (Int) -> Int {
bb0(%0 : $Int):
  %1 = function_ref @captureInt : $@convention(thin) (Int) -> Int
  %2 = partial_apply [callee_guaranteed] %1(%0) : $@convention(thin) (Int) -> Int
  %3 = begin_borrow %2
  %4 = convert_function %3 to $@callee_guaranteed () -> (Int, @error any Error)
  %5 = convert_escape_to_noescape %4 to $@noescape @callee_guaranteed () -> (Int, @error any Error)
  %6 = function_ref @observeThrowingClosure : $@convention(thin) (@guaranteed @callee_guaranteed () -> (Int, @error any Error)) -> ()
  %7 = apply %6(%4) : $@convention(thin) (@guaranteed @callee_guaranteed () -> (Int, @error any Error)) -> ()
  %8 = function_ref @consumeCatching : $@convention(thin) (@guaranteed @noescape @callee_guaranteed () -> (Int, @error any Error)) -> Int
  %9 = apply %8(%5) : $@convention(thin) (@guaranteed @noescape @callee_guaranteed () -> (Int, @error any Error)) -> Int
  destroy_value %5
  end_borrow %3
  destroy_value %2
  return %9
}

// The conversion in bb1 does not dominate the owner destroy in bb2.
// CHECK-LABEL:{{^}}sil [ossa] @keep_cross_block_conversion :
// CHECK:          %[[#OWNER:]] = partial_apply [callee_guaranteed] %[[#]](%[[#]])
// CHECK-NEXT:     %[[#BORROW:]] = begin_borrow %[[#OWNER]]
// CHECK-NEXT:     cond_br %[[#]], bb1, bb2
// CHECK:        bb1:
// CHECK-NEXT:     %[[#CONVERTED:]] = convert_function %[[#BORROW]] to $@callee_guaranteed () -> (Int, @error any Error)
// CHECK-NEXT:     %[[#NOESCAPE:]] = convert_escape_to_noescape %[[#CONVERTED]] to $@noescape @callee_guaranteed () -> (Int, @error any Error)
// CHECK:          destroy_value %[[#NOESCAPE]]{{( |$)}}
// CHECK-NEXT:     end_borrow %[[#BORROW]]{{( |$)}}
// CHECK-NEXT:     destroy_value %[[#OWNER]]{{( |$)}}
// CHECK-NEXT:     br bb3(%[[#]])
// CHECK:        bb2:
// CHECK-NEXT:     end_borrow %[[#BORROW]]{{( |$)}}
// CHECK-NEXT:     destroy_value %[[#OWNER]]{{( |$)}}
// CHECK-NEXT:     br bb3(%[[#]])
// CHECK:        bb3(%[[#RESULT:]] : $Int):
// CHECK-NEXT:     return %[[#RESULT]]{{( |$)}}
// CHECK-NEXT:   {{^}}} // end sil function 'keep_cross_block_conversion'
sil [ossa] @keep_cross_block_conversion : $@convention(thin) (Int, Builtin.Int1) -> Int {
bb0(%0 : $Int, %1 : $Builtin.Int1):
  %2 = function_ref @captureInt : $@convention(thin) (Int) -> Int
  %3 = partial_apply [callee_guaranteed] %2(%0) : $@convention(thin) (Int) -> Int
  %4 = begin_borrow %3
  cond_br %1, bb1, bb2

bb1:
  %5 = convert_function %4 to $@callee_guaranteed () -> (Int, @error any Error)
  %6 = convert_escape_to_noescape %5 to $@noescape @callee_guaranteed () -> (Int, @error any Error)
  %7 = function_ref @consumeCatching : $@convention(thin) (@guaranteed @noescape @callee_guaranteed () -> (Int, @error any Error)) -> Int
  %8 = apply %7(%6) : $@convention(thin) (@guaranteed @noescape @callee_guaranteed () -> (Int, @error any Error)) -> Int
  destroy_value %6
  end_borrow %4
  destroy_value %3
  br bb3(%8)

bb2:
  end_borrow %4
  destroy_value %3
  br bb3(%0)

bb3(%9 : $Int):
  return %9
}

// This exception must not remove an explicitly lexical borrow.
// CHECK-LABEL:{{^}}sil [ossa] @keep_lexical_borrow :
// CHECK:          %[[#OWNER:]] = partial_apply [callee_guaranteed] %[[#]](%[[#]])
// CHECK-NEXT:     %[[#BORROW:]] = begin_borrow [lexical] %[[#OWNER]]
// CHECK-NEXT:     %[[#CONVERTED:]] = convert_function %[[#BORROW]] to $@callee_guaranteed () -> (Int, @error any Error)
// CHECK-NEXT:     %[[#NOESCAPE:]] = convert_escape_to_noescape %[[#CONVERTED]] to $@noescape @callee_guaranteed () -> (Int, @error any Error)
// CHECK:          destroy_value %[[#NOESCAPE]]{{( |$)}}
// CHECK-NEXT:     end_borrow %[[#BORROW]]{{( |$)}}
// CHECK-NEXT:     destroy_value %[[#OWNER]]{{( |$)}}
// CHECK:          return %[[#]]{{( |$)}}
// CHECK-NEXT:   {{^}}} // end sil function 'keep_lexical_borrow'
sil [ossa] @keep_lexical_borrow : $@convention(thin) (Int) -> Int {
bb0(%0 : $Int):
  %1 = function_ref @captureInt : $@convention(thin) (Int) -> Int
  %2 = partial_apply [callee_guaranteed] %1(%0) : $@convention(thin) (Int) -> Int
  %3 = begin_borrow [lexical] %2
  %4 = convert_function %3 to $@callee_guaranteed () -> (Int, @error any Error)
  %5 = convert_escape_to_noescape %4 to $@noescape @callee_guaranteed () -> (Int, @error any Error)
  %6 = function_ref @consumeCatching : $@convention(thin) (@guaranteed @noescape @callee_guaranteed () -> (Int, @error any Error)) -> Int
  %7 = apply %6(%5) : $@convention(thin) (@guaranteed @noescape @callee_guaranteed () -> (Int, @error any Error)) -> Int
  destroy_value %5
  end_borrow %3
  destroy_value %2
  return %7
}

// Keep the general pointer-escape guard for unrelated instructions.
// CHECK-LABEL:{{^}}sil [ossa] @keep_nonfunction_pointer_escape :
// CHECK:          %[[#OWNER:]] = alloc_box ${ var Int }
// CHECK-NEXT:     %[[#BORROW:]] = begin_borrow %[[#OWNER]]
// CHECK-NEXT:     %[[#ADDRESS:]] = project_box %[[#BORROW]], 0
// CHECK:          end_borrow %[[#BORROW]]{{( |$)}}
// CHECK-NEXT:     destroy_value %[[#OWNER]]{{( |$)}}
// CHECK:          return %[[#]]{{( |$)}}
// CHECK-NEXT:   {{^}}} // end sil function 'keep_nonfunction_pointer_escape'
sil [ossa] @keep_nonfunction_pointer_escape : $@convention(thin) (Int) -> Int {
bb0(%0 : $Int):
  %1 = alloc_box ${ var Int }
  %2 = begin_borrow %1
  %3 = project_box %2, 0
  store %0 to [trivial] %3
  %4 = function_ref @touchInt : $@convention(thin) (@inout Int) -> ()
  %5 = apply %4(%3) : $@convention(thin) (@inout Int) -> ()
  %6 = load [trivial] %3
  end_borrow %2
  destroy_value %1
  return %6
}
