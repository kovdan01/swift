// RUN: %target-sil-opt -enable-sil-verify-all -closure-specialization %s -o - | %FileCheck %s
//
// Reduced from the generated functions and custom pullback closures in
// validation-test/closure_specialization/adcs_recursive_forwarding.swift.
// Emit optimized SIL with closure-specialization, autodiff-closure-specialization,
// and ownership-model-eliminator disabled; remove unrelated definitions.
//
// A closure forwarded through a finite recursive call, but never invoked, must
// not cause unbounded analysis or become a profitable specialization candidate.
// CHECK-LABEL: sil private {{.*}}@$s25adcs_recursive_forwarding25vjpIdentityWithForwardingySf5value_S2fc8pullbacktSf_SitFS2fcfU_ :
// CHECK: partial_apply
// CHECK: function_ref @$s25adcs_recursive_forwarding13forwardUnusedyS3fc_SiSftF :
// CHECK: return
//
// All three statically known closures can specialize over ordinary rounds.
// This positive control does not require value-sensitive recursive analysis.
// CHECK-LABEL: sil private {{.*}}@$s25adcs_recursive_forwarding20vjpRotatedDerivativeySf5value_S2fc8pullbacktSf_SitFS2fcfU_ :
// CHECK-NOT: partial_apply
// CHECK: function_ref @{{[^ ]+}} : $@convention(thin) (Int, Float, Float) -> Float
// CHECK-NOT: partial_apply
// CHECK: return

sil_stage canonical

import Builtin
import Swift
import SwiftShims
import _Differentiation

sil [noinline] [ossa] @$s25adcs_recursive_forwarding13forwardUnusedyS3fc_SiSftF : $@convention(thin) (@guaranteed @callee_guaranteed (Float) -> Float, Int, Float) -> Float {
[%0: noescape **, read v**.c*.v**, write v**.c*.v**, copy v**.c*.v**, destroy v**.c*.v**]
[global: read,write,copy,destroy,allocate,deinit_barrier]
// %0 "body"                                      // users: %19, %3
// %1 "depth"                                     // users: %7, %4
// %2 "seed"                                      // users: %19, %10, %5
bb0(%0 : @guaranteed $@callee_guaranteed (Float) -> Float, %1 : $Int, %2 : $Float):
  debug_value %0, let, name "body", argno 1       // id: %3
  debug_value %1, let, name "depth", argno 2      // id: %4
  debug_value %2, let, name "seed", argno 3       // id: %5
  %6 = integer_literal $Builtin.Int64, 0          // user: %8
  %7 = struct_extract %1, #Int._value             // users: %13, %8
  %8 = builtin "cmp_eq_Int64"(%7, %6) : $Builtin.Int1 // user: %9
  cond_br %8, bb1, bb2                            // id: %9

bb1:                                              // Preds: bb0
  br bb3(%2)                                      // id: %10

bb2:                                              // Preds: bb0
  %11 = integer_literal $Builtin.Int64, 1         // user: %13
  %12 = integer_literal $Builtin.Int1, -1         // user: %13
  %13 = builtin "ssub_with_overflow_Int64"(%7, %11, %12) : $(Builtin.Int64, Builtin.Int1) // users: %15, %14
  %14 = tuple_extract %13, 0                      // user: %17
  %15 = tuple_extract %13, 1                      // user: %16
  cond_fail %15, "arithmetic overflow"            // id: %16
  %17 = struct $Int (%14)                         // user: %19
  // function_ref forwardUnused(_:_:_:)
  %18 = function_ref @$s25adcs_recursive_forwarding13forwardUnusedyS3fc_SiSftF : $@convention(thin) (@guaranteed @callee_guaranteed (Float) -> Float, Int, Float) -> Float // user: %19
  %19 = apply %18(%0, %17, %2) : $@convention(thin) (@guaranteed @callee_guaranteed (Float) -> Float, Int, Float) -> Float // user: %20
  br bb3(%19)                                     // id: %20

// %21                                            // user: %22
bb3(%21 : $Float):                                // Preds: bb2 bb1
  return %21                                      // id: %22
} // end sil function '$s25adcs_recursive_forwarding13forwardUnusedyS3fc_SiSftF'

