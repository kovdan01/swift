// CHECK: (%{{.*}}, %{{.*}}, %[[SAVED:[0-9]+]]) = destructure_tuple
// CHECK: tuple_extract %[[SAVED]]
// CHECK: apply
// CHECK: return
// CHECK-NOT: _AD__{{.*}}_spec

sil_stage canonical
import Builtin
import Swift
import SwiftShims
sil @makeFloat : $@convention(thin) (Float) -> Float

