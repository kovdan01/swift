// RUN: %target-sil-opt -enable-sil-verify-all -autodiff-closure-specialization %s -o %t.sil
// RUN: %FileCheck %s < %t.sil
// RUN: %FileCheck %s --check-prefix=TWICE < %t.sil
// RUN: %FileCheck %s --check-prefix=TRIPLE < %t.sil
//
// Supplemental callable-identity coverage. The two generated VJPs below share
// one original pullback and exactly the same specialized payload layout, but
// their eliminated closures call twice and threeTimes respectively. The final
// VJP is an alias with the same body as the first, exercising exact-plan reuse.
//
// Derived from a Swift callableBranch(x, body, flag) which branches between
// applyLinear(x, body) and applyLinear(x, body) + x. applyLinear has a custom
// derivative returning body as its pullback. Compile with -O, inline threshold
// zero, and ownership elimination disabled, then inline the derivative thunks.
// Remove unrelated functions, debug instructions, and printed forwarding flags.
//
// CHECK-LABEL: sil shared {{.*}}@$s16CallableIdentity14callableBranchyS2f_S2fcSbtFTJrSUUpSr04$s16A19Identity5twiceyS2fFTf1ncn_n :
// CHECK: function_ref @[[TWICE_PB:[^ ]+]] : $@convention(thin) (Float, @owned [[LAYOUT:_AD__[^ )]+_spec_[^ )]+]]) -> Float
// CHECK-LABEL: sil shared {{.*}}@$s16CallableIdentity14callableBranchyS2f_S2fcSbtFTJrSUUpSr04$s16A25Identity10threeTimesyS2fFTf1ncn_n :
// CHECK-NOT: @[[TWICE_PB]]
// CHECK: function_ref @[[TRIPLE_PB:[^ ]+]] : $@convention(thin) (Float, @owned [[LAYOUT]]) -> Float
// CHECK-NOT: @[[TWICE_PB]]
// CHECK: return
// CHECK-LABEL: sil shared {{.*}}@$s16CallableIdentity14callableBranchyS2f_S2fcSbtFTJrSUUpSr04$s16A19Identity5twiceyS2fFTf1ncn_nTf4nn_n :
// CHECK: function_ref @[[TWICE_PB]] : $@convention(thin) (Float, @owned [[LAYOUT]]) -> Float
//
// Each generated body must call its own eliminated callable.
// TWICE-LABEL: sil shared {{.*}}@$s16CallableIdentity14callableBranchyS2f_S2fcSbtFTJrSUUpSr04$s16A19Identity5twiceyS2fFTf1ncn_n :
// TWICE: function_ref @[[PB:[^ ]+]] : $@convention(thin) (Float, @owned {{.*}}_spec_{{.*}}) -> Float
// TWICE: sil {{.*}} @[[PB]] :
// TWICE-NOT: } // end sil function
// TWICE: function_ref @$s16CallableIdentity5twiceyS2fF
//
// TRIPLE-LABEL: sil shared {{.*}}@$s16CallableIdentity14callableBranchyS2f_S2fcSbtFTJrSUUpSr04$s16A25Identity10threeTimesyS2fFTf1ncn_n :
// TRIPLE: function_ref @[[PB:[^ ]+]] : $@convention(thin) (Float, @owned {{.*}}_spec_{{.*}}) -> Float
// TRIPLE: sil {{.*}} @[[PB]] :
// TRIPLE-NOT: } // end sil function
// TRIPLE: function_ref @$s16CallableIdentity10threeTimesyS2fF

sil_stage canonical

