bb1(%t : @owned $(predecessor: _AD__$s3outyycfU6_7myfoo08L_yS2f_SftF_bb0__Pred__src_0_wrt_1, @callee_guaranteed (Float) -> Float)):
  (%prev, %c) = destructure_tuple %t : $(predecessor: _AD__$s3outyycfU6_7myfoo08L_yS2f_SftF_bb0__Pred__src_0_wrt_1, @callee_guaranteed (Float) -> Float)
  %bc = begin_borrow %c : $@callee_guaranteed (Float) -> Float
  %r = apply %bc(%x) : $@callee_guaranteed (Float) -> Float
  end_borrow %bc : $@callee_guaranteed (Float) -> Float
  destroy_value %c : $@callee_guaranteed (Float) -> Float
