// RUN: %target-sil-opt -sil-print-types -enable-sil-verify-all -autodiff-closure-specialization %s -o - | %FileCheck %s

// Supplemental reduced SIL robustness case. The corresponding source-derived
// coverage is adcs_runtime_wrapper.{swift,sil}. A source closure expression
// captures the runtime wrapper in a static closure entry point. The unusual
// runtime-callee partial_apply below is valid SIL but is not emitted for that
// source construct. Specialization must preserve the runtime callee while
// eliminating the outer tape field containing the wrapped closure.

// The replacement payload preserves both the existing root closure context
// and the runtime wrapper callee. It does not allocate another inner closure.
// CHECK: enum {{.*}}_spec
// CHECK: tuple (%{{[0-9]+}} : $@callee_guaranteed (Float) -> Float, %{{[0-9]+}} : $@callee_guaranteed (Float, @guaranteed @callee_guaranteed (Float) -> Float) -> Float)
// CHECK-LABEL: // specialized pullback of
// CHECK-NOT: = partial_apply
// CHECK: apply %{{[0-9]+}}(%{{[0-9]+}}, %{{[0-9]+}}) : $@callee_guaranteed (Float, @guaranteed @callee_guaranteed (Float) -> Float) -> Float
// CHECK-NOT: = partial_apply
// CHECK: apply %{{[0-9]+}}(%{{[0-9]+}}, %{{[0-9]+}}) : $@callee_guaranteed (Float, @guaranteed @callee_guaranteed (Float) -> Float) -> Float
// CHECK-NOT: = partial_apply
// CHECK: } // end sil function

sil_stage canonical
import Builtin
import Swift
import SwiftShims
import _Differentiation

sil @wrapper : $@convention(thin) (Float, @guaranteed @callee_guaranteed (Float) -> Float) -> Float

sil @capturing : $@convention(thin) (Float, @in_guaranteed String) -> Float

enum _AD__$s3outyycfU6_7myfoo08L_yS2f_SftF_bb0__Pred__src_0_wrt_1 {
 case bb2(())
}
enum _AD__$s3outyycfU6_7myfoo08L_yS2f_SftF_bb1__Pred__src_0_wrt_1 {
  case bb0((predecessor: _AD__$s3outyycfU6_7myfoo08L_yS2f_SftF_bb0__Pred__src_0_wrt_1, (Float) -> Float))
  case bb2((predecessor: _AD__$s3outyycfU6_7myfoo08L_yS2f_SftF_bb0__Pred__src_0_wrt_1, (Float) -> Float))
}

sil [ossa] @$s3outyycfU6_7myfoo08L_yS2f_SftFTJrSUpSr : $@convention(thin) (@owned String, Float, Bool, @owned @callee_guaranteed (Float, @guaranteed @callee_guaranteed (Float) -> Float) -> Float) -> (Float, @owned @callee_guaranteed (Float) -> Float) {
bb0(%s : @owned $String, %x : $Float, %b : $Bool, %dynamic : @owned $@callee_guaranteed (Float, @guaranteed @callee_guaranteed (Float) -> Float) -> Float):
  %addr = alloc_stack $String
  store %s to [init] %addr : $*String
  %fn = function_ref @capturing : $@convention(thin) (Float, @in_guaranteed String) -> Float
  %c = partial_apply [callee_guaranteed] %fn(%addr) : $@convention(thin) (Float, @in_guaranteed String) -> Float
  dealloc_stack %addr : $*String
  %unit = tuple ()
  %prev = enum $_AD__$s3outyycfU6_7myfoo08L_yS2f_SftF_bb0__Pred__src_0_wrt_1, #_AD__$s3outyycfU6_7myfoo08L_yS2f_SftF_bb0__Pred__src_0_wrt_1.bb2!enumelt, %unit
  %wc = partial_apply [callee_guaranteed] %dynamic(%c) : $@callee_guaranteed (Float, @guaranteed @callee_guaranteed (Float) -> Float) -> Float
  %cond = struct_extract %b : $Bool, #Bool._value
  cond_br %cond, bb1, bb2
bb1:
  %t = tuple $(predecessor: _AD__$s3outyycfU6_7myfoo08L_yS2f_SftF_bb0__Pred__src_0_wrt_1, @callee_guaranteed (Float) -> Float) (%prev, %wc)
  %e = enum $_AD__$s3outyycfU6_7myfoo08L_yS2f_SftF_bb1__Pred__src_0_wrt_1, #_AD__$s3outyycfU6_7myfoo08L_yS2f_SftF_bb1__Pred__src_0_wrt_1.bb0!enumelt, %t
  br bb3(%e : $_AD__$s3outyycfU6_7myfoo08L_yS2f_SftF_bb1__Pred__src_0_wrt_1)
bb2:
  %u = tuple $(predecessor: _AD__$s3outyycfU6_7myfoo08L_yS2f_SftF_bb0__Pred__src_0_wrt_1, @callee_guaranteed (Float) -> Float) (%prev, %wc)
  %e2 = enum $_AD__$s3outyycfU6_7myfoo08L_yS2f_SftF_bb1__Pred__src_0_wrt_1, #_AD__$s3outyycfU6_7myfoo08L_yS2f_SftF_bb1__Pred__src_0_wrt_1.bb2!enumelt, %u
  br bb3(%e2 : $_AD__$s3outyycfU6_7myfoo08L_yS2f_SftF_bb1__Pred__src_0_wrt_1)
bb3(%be : @owned $_AD__$s3outyycfU6_7myfoo08L_yS2f_SftF_bb1__Pred__src_0_wrt_1):
  %pb = function_ref @$s3outyycfU6_7myfoo08L_yS2f_SftFTJpSUpSr : $@convention(thin) (Float, @owned _AD__$s3outyycfU6_7myfoo08L_yS2f_SftF_bb1__Pred__src_0_wrt_1) -> Float
  %p = partial_apply [callee_guaranteed] %pb(%be) : $@convention(thin) (Float, @owned _AD__$s3outyycfU6_7myfoo08L_yS2f_SftF_bb1__Pred__src_0_wrt_1) -> Float
  %r = tuple (%x, %p)
  return %r : $(Float, @callee_guaranteed (Float) -> Float)
}

sil [ossa] @$s3outyycfU6_7myfoo08L_yS2f_SftFTJpSUpSr : $@convention(thin) (Float, @owned _AD__$s3outyycfU6_7myfoo08L_yS2f_SftF_bb1__Pred__src_0_wrt_1) -> Float {
