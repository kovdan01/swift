bb2(%u : @owned $(predecessor: _AD__$s3outyycfU6_7myfoo08L_yS2f_SftF_bb0__Pred__src_0_wrt_1, @callee_guaranteed (Float) -> Float)):
  (%prev2, %c2) = destructure_tuple %u : $(predecessor: _AD__$s3outyycfU6_7myfoo08L_yS2f_SftF_bb0__Pred__src_0_wrt_1, @callee_guaranteed (Float) -> Float)
  %bc2 = begin_borrow %c2 : $@callee_guaranteed (Float) -> Float
  %r2 = apply %bc2(%x) : $@callee_guaranteed (Float) -> Float
  end_borrow %bc2 : $@callee_guaranteed (Float) -> Float
  destroy_value %c2 : $@callee_guaranteed (Float) -> Float
  br bb3(%r2 : $Float)
bb3(%result : $Float):
  return %result : $Float
}
