// RUN: %target-sil-opt -sil-print-types -enable-sil-verify-all -autodiff-closure-specialization %s -o - | %FileCheck %s --implicit-check-not='_AD__{{.*}}_spec'

// Reduced unsupported-SIL boundary. In adcs_discarded_pullback.{swift,sil}, an
// unused inner closure is nested in the outer tape context; inactive original
// calls do not receive a taped derivative. A directly taped callback without
// an invocation is not generated, so reject it before enum specialization.

// CHECK-LABEL: sil [ossa] @$s3outyycfU6_7myfoo08L_yS2f_SftFTJpSUpSr
// CHECK-NOT: = apply
// CHECK: destroy_value {{.*}} : $@callee_guaranteed (Float) -> Float
// CHECK: } // end sil function

sil_stage canonical
import Builtin
import Swift
import SwiftShims
import _Differentiation

sil @capturing : $@convention(thin) (Float, @in_guaranteed String) -> Float

