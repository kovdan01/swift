// RUN: split-file %s %t
// RUN: %target-sil-opt -enable-sil-verify-all -early-inline %t/missing.sil -o - | %FileCheck %s --check-prefix=MISSING
// RUN: %target-sil-opt -enable-sil-verify-all -early-inline %t/empty.sil -o - | %FileCheck %s --check-prefix=EMPTY
// RUN: %target-sil-opt -enable-sil-verify-all -early-inline %t/scalar.sil -o - | %FileCheck %s --check-prefix=SCALAR
//
// Robustness inputs reduced from the cube VJP and generated wrapper VJP thunk
// in validation-test/unused_pullback_inlining.swift, compiled with -O
// -D DEFINITIONS_ONLY -module-name unused_pullback_inlining. The thunk's CFG
// comes from inlining its explicit custom derivative. All derivative and
// closure names below are compiler-generated; referenced helpers are external.
//
// These are deliberately reduced intermediate forms, not verbatim compiler
// snapshots. The cube VJP's returned closure is destroyed inside that function,
// and its result ABI is pruned to trivial fields, an empty tuple, or a scalar.
// The caller no longer projects a pullback. Keeping that discarded result
// trivial allows the missing projection to be removed without leaking an owned
// closure. Normal compilation of the source retains a pullback projection and
// destroy until it removes the unused closure; no source assertion is claimed.
//
// The direct-pullback-use query must return false for unsupported result shapes
// rather than asserting. Later inlining policy may still inline the callee;
// the resulting caller must retain valid control flow and ownership.

// MISSING-LABEL: sil [thunk] [ossa] @$s24unused_pullback_inlining7wrapperyS2fFTJrSpSr :
// MISSING: cond_br
// MISSING: return
// MISSING-NEXT: } // end sil function

// EMPTY-LABEL: sil [thunk] [ossa] @$s24unused_pullback_inlining7wrapperyS2fFTJrSpSr :
// EMPTY: cond_br
// EMPTY: return
// EMPTY-NEXT: } // end sil function

// SCALAR-LABEL: sil [thunk] [ossa] @$s24unused_pullback_inlining7wrapperyS2fFTJrSpSr :
// SCALAR: cond_br
// SCALAR: return
// SCALAR-NEXT: } // end sil function

//--- missing.sil
sil_stage canonical
