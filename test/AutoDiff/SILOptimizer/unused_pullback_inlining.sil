  // function_ref reverse-mode derivative of static Float.* infix(_:_:)
  %8 = function_ref @$sSf1moiyS2f_SftFZTJrSSUpSr : $@convention(method) (Float, Float, @thin Float.Type) -> (Float, @owned @callee_guaranteed (Float) -> (Float, Float)) // user: %9
  %9 = apply %8(%6, %0, %2) : $@convention(method) (Float, Float, @thin Float.Type) -> (Float, @owned @callee_guaranteed (Float) -> (Float, Float)) // user: %10
  (%10, %11) = destructure_tuple %9               // users: %14, %13
  // function_ref pullback of cube(_:)
  %12 = function_ref @$s24unused_pullback_inlining4cubeyS2fFTJpSpSr : $@convention(thin) (Float, @owned @callee_guaranteed (Float) -> (Float, Float), @owned @callee_guaranteed (Float) -> (Float, Float)) -> Float // user: %13
